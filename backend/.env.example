# CareerFlow SG - Environment Configuration
# Copy this to .env and fill in your values

# Groq API Key (Free tier - Llama 3.3 70B)
# Get yours at: https://console.groq.com/keys
MODEL_API_KEY=groq-your-api-key-here

# MyCareersFuture API Base (default is public, no auth needed)
MCF_API_BASE=https://api.mycareersfuture.gov.sg/v2

# Invite Codes (comma-separated)
# Give these to your trusted users. They need this to access the app.
INVITE_CODES=careerflow2026,hackathon,metaai,your-custom-code-1,your-custom-code-2
