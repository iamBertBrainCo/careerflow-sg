# ─────────────────────────────────────────────────────────────────────
# CareerFlow SG — settings
#
# 1. Copy this file to a new file called .env (in this same backend folder)
# 2. Pick ONE AI provider below: keep its three lines, paste your key
# 3. Restart the backend
#
# Your .env stays on your computer. Never share it or commit it to git.
# ─────────────────────────────────────────────────────────────────────

# ── Option A: Groq (free tier, fast; the default) ─────────────────────
# Get a free key: https://console.groq.com/keys  (starts with gsk_)
LLM_BASE_URL=https://api.groq.com/openai/v1
MODEL_ID=openai/gpt-oss-120b
MODEL_API_KEY=paste-your-key-here

# ── Option B: Google Gemini (free tier) ───────────────────────────────
# Get a free key: https://aistudio.google.com/apikey
# Current model names: https://ai.google.dev/gemini-api/docs/models
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL_ID=gemini-2.5-flash
# MODEL_API_KEY=paste-your-key-here

# ── Option C: OpenRouter (many models, some free) ─────────────────────
# Get a key: https://openrouter.ai/keys
# Free models end in ":free": https://openrouter.ai/models?q=free
# LLM_BASE_URL=https://openrouter.ai/api/v1
# MODEL_ID=openai/gpt-oss-120b:free
# MODEL_API_KEY=paste-your-key-here

# ── Option D: Ollama (runs on your own laptop, no key, works offline) ─
# Install from https://ollama.com, then run:  ollama pull qwen3:8b
# Slower, and needs a laptop with 16 GB+ memory for good results.
# LLM_BASE_URL=http://localhost:11434/v1
# MODEL_ID=qwen3:8b
# MODEL_API_KEY=

# ── Other settings (usually leave as they are) ────────────────────────
# Invite code(s) for the sign-in screen, comma-separated
INVITE_CODES=bertbrainco

# MyCareersFuture public job search API (no key needed)
MCF_API_BASE=https://api.mycareersfuture.gov.sg/v2
